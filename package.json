{
  "name": "litepdf",
  "version": "0.1.8",
  "description": "轻量多标签 PDF 阅读器（Electron + Foxit WebSDK UIExtension）",
  "main": "dist-electron/main.js",
  "author": "LitePDF",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-sdk.mjs",
    "predev": "node scripts/ensure-sdk.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-sdk.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --config electron-builder.yml",
    "pack:win": "npm run build && electron-builder --config electron-builder.yml --win",
    "pack:mac": "npm run build && electron-builder --config electron-builder.yml --mac",
    "typecheck": "vue-tsc --noEmit",
    "sync:license": "node scripts/sync-license-env.mjs"
  },
  "dependencies": {
    "@foxitsoftware/foxit-pdf-sdk-for-web-library": "^11.1.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.8"
  }
}
